// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==================== 使用者系統 ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // 用於 credentials 認證
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 關聯
  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  reviews       Review[]
  collections   Collection[]
}

// NextAuth.js 帳號 (OAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth.js Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth.js 驗證 Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== 工具系統 ====================
// 注意：工具資料主要存儲在靜態 JSON 中 (lib/tools.ts)
// 這裡僅保留 Tool model 供未來擴展使用（例如動態新增工具）
// 但收藏、評論等功能使用 toolId (Int) 直接對應靜態資料的 ID

// ==================== 收藏系統 ====================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    Int      // 對應靜態工具資料中的 ID
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 移除 Tool 外鍵，因為工具資料是靜態的

  @@unique([userId, toolId])
}

// ==================== 評論系統 ====================

model Review {
  id        String   @id @default(cuid())
  userId    String
  toolId    Int      // 對應靜態工具資料中的 ID
  rating    Int      // 1-5 星
  title     String?
  content   String
  pros      String?  // JSON 字串存儲優點
  cons      String?  // JSON 字串存儲缺點
  helpful   Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 移除 Tool 外鍵，因為工具資料是靜態的

  @@unique([userId, toolId]) // 每個用戶只能對每個工具評論一次
}

// ==================== 合集系統 ====================

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  toolId       Int      // 對應靜態工具資料中的 ID
  note         String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // 移除 Tool 外鍵，因為工具資料是靜態的

  @@unique([collectionId, toolId])
}
