// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==================== 使用者系統 ====================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  password      String?    // 用於 credentials 認證
  image         String?
  bio           String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // 關聯
  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  reviews       Review[]
  collections   Collection[]
  submissions   ToolSubmission[]
  notifications Notification[]
}

// NextAuth.js 帳號 (OAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth.js Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth.js 驗證 Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== 工具系統 ====================
// 工具資料統一存儲在資料庫中
// Phase 3.5: 已將靜態 JSON 遷移至資料庫

model Tool {
  id              Int      @id @default(autoincrement())
  slug            String   @unique  // URL 友善的唯一識別碼
  name            String
  description     String
  fullDescription String?  // 完整描述
  url             String
  logo            String?
  category        String
  pricing         String   // free, freemium, paid
  features        String?  // JSON 字串
  tags            String?  // JSON 字串
  pricingPlans    String?  // JSON 字串 - 定價方案
  screenshots     String?  // JSON 字串 - 截圖 URL 列表
  relatedToolIds  String?  // JSON 字串 - 相關工具 ID 列表
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)  // 精選工具
  order           Int      @default(0)       // 排序權重
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 來源提交 (用戶提交的工具)
  submissionId String?        @unique
  submission   ToolSubmission? @relation(fields: [submissionId], references: [id])
  
  // 評論關聯
  reviews      Review[]
}

// ==================== 工具提交系統 ====================

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ToolSubmission {
  id            String           @id @default(cuid())
  userId        String
  name          String
  description   String
  url           String
  logo          String?
  category      String
  pricing       String           // free, freemium, paid
  features      String?          // JSON 字串
  tags          String?          // JSON 字串
  submitterNote String?          // 提交者備註
  status        SubmissionStatus @default(PENDING)
  reviewNote    String?          // 審核備註
  reviewedAt    DateTime?
  reviewedBy    String?          // 審核者 User ID
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool?
}

// ==================== 通知系統 ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // submission_approved, submission_rejected, etc.
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== 收藏系統 ====================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    Int      // 對應靜態工具資料中的 ID
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 移除 Tool 外鍵，因為工具資料是靜態的

  @@unique([userId, toolId])
}

// ==================== 評論系統 ====================

model Review {
  id        String   @id @default(cuid())
  userId    String
  toolId    Int      // 對應 Tool 模型的 ID
  rating    Int      // 1-5 星
  title     String?
  content   String
  pros      String?  // JSON 字串存儲優點
  cons      String?  // JSON 字串存儲缺點
  helpful   Int      @default(0)
  verified  Boolean  @default(false)
  isHidden  Boolean  @default(false) // 管理員隱藏評論
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool  Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  likes ReviewLike[]

  @@unique([userId, toolId]) // 每個用戶只能對每個工具評論一次
}

// 評論按讚
model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId]) // 每個用戶只能對每則評論按讚一次
}

// ==================== 合集系統 ====================

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  toolId       Int      // 對應靜態工具資料中的 ID
  note         String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // 移除 Tool 外鍵，因為工具資料是靜態的

  @@unique([collectionId, toolId])
}
